rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function role() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isAdmin() { return role() == 'admin'; }
    function canEdit() { return role() in ['admin', 'hr']; }
    function canView() { return role() in ['admin', 'hr', 'manager']; }

    // Only admins can read/write user-role assignments (create these manually in the console).
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if canView();
      allow create, update: if canEdit();
      allow delete: if isAdmin();
    }

    // Audit log: anyone who can edit records can write an entry; nobody may edit or delete past entries.
    match /auditLogs/{entryId} {
      allow read: if canView();
      allow create: if canEdit();
      allow update, delete: if false;
    }
  }
}
